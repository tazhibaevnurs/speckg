# Database: empty = local SQLite. Production: Supabase URI (Settings → Database → URI).
# Prefer Session mode :5432 for Django, or Transaction pooler :6543 (already handled).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Public site URL (sitemap, Open Graph)
